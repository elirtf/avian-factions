#!/usr/bin/env bash
# ./dev — one command for running the Avian Factions dev server. See docs/DEVELOPING.md.
#
# The server runs inside a tmux session called "avian", so it keeps running when you close your
# terminal, and you can open its console again at any time with `./dev console`.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SESSION="${AVIAN_DEV_SESSION:-avian}"
LOG="${AVIAN_LOG:-$ROOT/run/logs/latest.log}"   # AVIAN_LOG: check another log (the container's)
RANKS="$ROOT/dev-server/luckperms/ranks.lp"
SETUP_STAMP="$ROOT/run/.dev-setup-applied"
PACK_STAMP="$ROOT/run/.dev-pack-built"
WORLD_BORDER=10000
ENV_FILE="${AVIAN_ENV_FILE:-./.env}"   # AVIAN_ENV_FILE: another settings file (restore-container, a prod .env)
START_TIMEOUT=300   # seconds; the first start also downloads Paper and builds FactionsUUID
STOP_TIMEOUT=90

cd "$ROOT"

# --- Output helpers -------------------------------------------------------------------------------

if [[ -t 1 ]]; then
    BOLD=$'\e[1m'; DIM=$'\e[2m'; RED=$'\e[31m'; GREEN=$'\e[32m'; GOLD=$'\e[33m'; RESET=$'\e[0m'
else
    BOLD=""; DIM=""; RED=""; GREEN=""; GOLD=""; RESET=""
fi
say()  { echo "${GOLD}▸${RESET} $*"; }
ok()   { echo "${GREEN}✓${RESET} $*"; }
fail() { echo "${RED}✗ $*${RESET}" >&2; exit 1; }

# --- State checks ---------------------------------------------------------------------------------

session_running() { tmux has-session -t "$SESSION" 2>/dev/null; }

# A Paper server for this project started some other way (plain ./gradlew runServer in a terminal).
stray_server_pid() {
    local pid
    for pid in $(pgrep -f 'jars/[0-9.]+/[0-9]+\.jar' || true); do
        if [[ "$(readlink "/proc/$pid/cwd" 2>/dev/null)" == "$ROOT/run" ]]; then
            echo "$pid"
            return
        fi
    done
}

load_env() {
    [[ -f "$ENV_FILE" ]] || fail "No $ENV_FILE file. Run ${BOLD}./dev setup${RESET} first."
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
}

need() {
    command -v "$1" >/dev/null 2>&1 || fail "$1 is not installed. $2"
}

db_healthy() {
    [[ "$(docker inspect -f '{{.State.Health.Status}}' avian-mariadb 2>/dev/null || true)" == healthy ]]
}

start_db() {
    if db_healthy; then
        return
    fi
    say "Starting the database (MariaDB in Docker)…"
    docker compose up -d --quiet-pull >/dev/null
    for _ in $(seq 1 60); do
        db_healthy && { ok "Database is up"; return; }
        sleep 2
    done
    fail "The database did not become healthy. Check: docker compose logs mariadb"
}

# --- Talking to the console -----------------------------------------------------------------------

# Sends one line to the server console, as if typed there.
send() {
    tmux send-keys -t "$SESSION" -l "$1"
    tmux send-keys -t "$SESSION" Enter
}

log_inode() {
    if [[ -f "$LOG" ]]; then stat -c %i "$LOG"; else echo none; fi
}

log_size() {
    if [[ -f "$LOG" ]]; then stat -c %s "$LOG"; else echo 0; fi
}

# Prints what the server logged after byte offset $1.
log_since() {
    if [[ -f "$LOG" ]]; then tail -c +"$(( $1 + 1 ))" "$LOG"; fi
}

wait_for_done() {
    local old_inode="$1" waited=0
    while (( waited < START_TIMEOUT )); do
        if ! session_running; then
            echo
            tail -n 30 "$LOG" >&2 || true
            fail "The server stopped while starting. The lines above are the end of its log."
        fi
        # Paper archives the previous latest.log at startup and starts a new file; until that new
        # file exists, the old one (which also says "Done") must not count.
        if [[ "$(log_inode)" == "$old_inode" ]]; then
            printf '.'; sleep 2; waited=$(( waited + 2 )); continue
        fi
        local text
        text="$(cat "$LOG" 2>/dev/null || true)"
        if grep -q 'Done (' <<<"$text"; then
            echo
            return 0
        fi
        if grep -qE 'refusing to start|refused to start' <<<"$text"; then
            echo
            grep -E 'AvianFactions' <<<"$text" | tail -n 20 >&2
            fail "Avian Factions refused to start; the reasons are listed above."
        fi
        printf '.'
        sleep 2
        waited=$(( waited + 2 ))
    done
    echo
    fail "The server did not finish starting within ${START_TIMEOUT}s. Look with: ./dev console"
}

# --- Commands -------------------------------------------------------------------------------------

cmd_setup() {
    need java   "Install any JDK 17 or newer to run Gradle (the right JDK 25 is downloaded for you)."
    need docker "Install Docker; the database runs in it."
    need tmux   "Install tmux; the server runs inside it."
    if [[ ! -f .env ]]; then
        cp .env.example .env
        ok "Created .env from .env.example (local database passwords)"
    fi
    load_env
    start_db
    say "Downloading the plugin stack and building FactionsUUID (slow the first time)…"
    ./gradlew --quiet downloadPlugins
    ok "Setup done. Start the server with: ${BOLD}./dev start${RESET}"
}

cmd_start() {
    local setup=1
    [[ "${1:-}" == "--no-setup" ]] && setup=0
    session_running && { ok "The server is already running. Open its console with: ./dev console"; return; }
    local stray
    stray="$(stray_server_pid)"
    [[ -n "$stray" ]] && fail "A server is already running outside ./dev (process $stray). Stop it first: type 'stop' in its console, or run: kill $stray"
    need tmux "Install tmux; the server runs inside it."
    load_env
    start_db
    local old_inode
    old_inode="$(log_inode)"
    say "Building the plugin and starting the server…"
    # downloadPlugins is instant when nothing changed; runServer builds our jar and copies dev-server/ config in.
    tmux new-session -d -s "$SESSION" -x 200 -y 50 \
        "set -a; . ./.env; set +a; ./gradlew --console=plain downloadPlugins runServer; echo; echo '[dev] Server stopped. This window closes in 5 seconds.'; sleep 5"
    wait_for_done "$old_inode"
    local port
    port="$(sed -n 's/^server-port=//p' run/server.properties 2>/dev/null || true)"
    ok "Server is up: connect Minecraft to localhost:${port:-25565}"
    if (( setup )); then
        if [[ "$(cat "$SETUP_STAMP" 2>/dev/null || true)" == "$(setup_fingerprint)" ]]; then
            ok "Ranks and world border unchanged since last applied (force it with: ./dev ranks)"
        else
            cmd_setup_world
        fi
        if [[ -f run/plugins/CraftEngine/generated/resource_pack.zip && "$(cat "$PACK_STAMP" 2>/dev/null || true)" == "$(pack_fingerprint)" ]]; then
            ok "Resource pack unchanged since last built (force it with: ./dev pack)"
        else
            cmd_pack
        fi
    fi
    echo "  Console: ${BOLD}./dev console${RESET}   Logs: ${BOLD}./dev logs${RESET}   Stop: ${BOLD}./dev stop${RESET}"
}

# What cmd_setup_world last applied: ranks.lp, the border, and the database container. A wiped
# database comes back in a new container, so its ranks are re-applied; a wiped run/ loses the stamp.
setup_fingerprint() {
    { cat "$RANKS"; echo "$WORLD_BORDER"; docker inspect -f '{{.Id}}' avian-mariadb 2>/dev/null || true; } \
        | sha256sum | cut -d' ' -f1
}

# Things that live in the world or LuckPerms' database rather than a config file. Safe to repeat,
# but every line echoes to online ops ("owner already has * set…"), so start skips it when nothing
# changed.
cmd_setup_world() {
    session_running || fail "The server is not running. Start it with: ./dev start"
    say "Applying the ranks from dev-server/luckperms/ranks.lp and the ${WORLD_BORDER}-block world border…"
    local count=0 line
    while IFS= read -r line; do
        [[ -z "${line// }" || "$line" =~ ^[[:space:]]*# ]] && continue
        send "$line"
        count=$(( count + 1 ))
        sleep 0.05
    done < "$RANKS"
    send "worldborder set $WORLD_BORDER"
    setup_fingerprint > "$SETUP_STAMP"
    ok "Applied $count rank commands and the world border"
}


# CraftEngine builds the resource pack only on /ce reload, never at startup, so start rebuilds it
# when its sources (our pack, the plugin jar) changed or no pack exists yet.
# The built pack survives restarts, so an unchanged start skips this.
pack_fingerprint() {
    {
        { find "$ROOT/dev-server/plugins/CraftEngine" -type f 2>/dev/null || true; } \
            | sort | xargs -r sha256sum
        for jar in "$ROOT"/run/plugins/craft-engine*.jar; do
            if [[ -e "$jar" ]]; then basename "$jar"; fi
        done
    } | sha256sum | cut -d" " -f1
}

# The whole server as a container image: the same Paper, plugins and config as ./dev start.
cmd_image() {
    need docker "Install Docker to build the image."
    say "Staging the image (plugin downloads, our jar, config)…"
    ./gradlew --quiet :avian-plugin:stageImage
    docker build -t "${AVIAN_IMAGE:-avian-factions:dev}" avian-plugin/build/image
    ok "Built ${AVIAN_IMAGE:-avian-factions:dev}. Run it: docker compose --profile server up -d (docs/DEPLOYMENT.md)"
}

# Lays dev-server/ over run/ with .env loaded, so the placeholders get this machine's values.
cmd_sync() {
    load_env
    ./gradlew --quiet :avian-plugin:syncDevConfig
    ok "Config copied into run/. Reload the plugin that changed, or ./dev restart"
}

cmd_pack() {
    session_running || fail "The server is not running. Start it with: ./dev start"
    say "Building the resource pack…"
    local log="$ROOT/run/logs/latest.log" before
    before="$(wc -l < "$log")"
    send "ce reload all"
    for _ in $(seq 1 120); do
        if tail -n +"$((before + 1))" "$log" | grep -q 'Resource pack generated'; then
            pack_fingerprint > "$PACK_STAMP"
            ok "Resource pack built and served on the game port"
            return
        fi
        sleep 1
    done
    fail "The resource pack did not finish building in 120s. Look with: ./dev logs"
}
cmd_stop() {
    if ! session_running; then
        local stray
        stray="$(stray_server_pid)"
        [[ -n "$stray" ]] && fail "The server running is not one ./dev started (process $stray). Type 'stop' in its console, or run: kill $stray"
        ok "The server is not running"
        return
    fi
    say "Stopping the server (it saves the world first)…"
    send "stop"
    for _ in $(seq 1 "$STOP_TIMEOUT"); do
        session_running || { ok "Server stopped"; return; }
        sleep 1
    done
    fail "The server is still stopping after ${STOP_TIMEOUT}s. Look with: ./dev console"
}

cmd_restart() {
    cmd_stop
    cmd_start "$@"
}

cmd_console() {
    session_running || fail "The server is not running. Start it with: ./dev start"
    echo "${BOLD}Opening the server console.${RESET} Type commands without a slash (e.g. ${BOLD}list${RESET})."
    echo "To leave and keep the server running: press ${BOLD}Ctrl-b${RESET}, let go, then press ${BOLD}d${RESET}."
    sleep 2
    tmux attach -t "$SESSION"
}

# Runs one console command and prints what the server answered.
cmd_cmd() {
    [[ $# -gt 0 ]] || fail "Usage: ./dev cmd <command>   e.g. ./dev cmd \"lp user Steve parent add raven\""
    session_running || fail "The server is not running. Start it with: ./dev start"
    local since
    since="$(log_size)"
    send "$*"
    sleep "${DEV_CMD_WAIT:-1}"
    log_since "$since" | sed -E 's/^\[[0-9:]+\] \[[^]]+\]: //'
}

cmd_logs() {
    [[ -f "$LOG" ]] || fail "No log yet. Start the server with: ./dev start"
    echo "${DIM}Following run/logs/latest.log. Press Ctrl-C to stop watching (the server keeps running).${RESET}"
    tail -n 50 -f "$LOG"
}

cmd_status() {
    if db_healthy; then ok "Database: running"; else echo "${RED}✗${RESET} Database: not running (./dev start starts it)"; fi
    if session_running; then
        ok "Server: running (./dev console to open it)"
    elif [[ -n "$(stray_server_pid)" ]]; then
        echo "${GOLD}!${RESET} Server: running outside ./dev (process $(stray_server_pid))"
    else
        echo "${RED}✗${RESET} Server: not running (./dev start)"
    fi
}

# Everything git cannot rebuild: the world, the database, and plugin data (factions, claims,
# homes, warps, regions, crate locations). Code and config live in git; this is the other half.
# Safe while the server runs: world saving is paused, flushed to disk, archived, then resumed.
BACKUP_DIR="${AVIAN_BACKUP_DIR:-backups}"

# True once no world file has changed for 3 seconds in a row; false after 60 seconds of changes.
world_quiet() {
    local before after tries=0
    before="$(find run/world* -type f -printf '%p %T@ %s\n' 2>/dev/null | sort)"
    while (( tries++ < 20 )); do
        sleep 3
        after="$(find run/world* -type f -printf '%p %T@ %s\n' 2>/dev/null | sort)"
        [[ "$before" == "$after" ]] && return 0
        before="$after"
    done
    return 1
}

cmd_backup() {
    load_env
    db_healthy || fail "The database is not running. Start it with: ./dev start"
    [[ -d run/world ]] || fail "There is no world in run/ to back up yet."
    mkdir -p "$BACKUP_DIR"
    local stamp work archive
    stamp="$(date +%Y%m%d-%H%M%S)"
    work="$(mktemp -d)"
    archive="$BACKUP_DIR/avian-backup-$stamp.tar.gz"

    local live=false
    if session_running; then
        live=true
        say "Server is running: pausing world saves and flushing to disk…"
        local since
        since="$(log_size)"
        send "save-off"
        send "save-all flush"
        # Wait for the server to say the save finished, not a fixed time: right after a big paste
        # there are thousands of dirty chunks, and a 5-second guess let tar read a file mid-write.
        local waited=0
        until log_since "$since" | grep -q "Saved the game"; do
            (( waited++ >= 180 )) && { send "save-on"; rm -rf "$work"; fail "The save did not finish within 3 minutes; no backup taken."; }
            sleep 1
        done
        world_quiet || { send "save-on"; rm -rf "$work"; fail "World files kept changing after the save; no backup taken."; }
    fi

    say "Dumping the database…"
    docker exec avian-mariadb mariadb-dump -u"$AVIAN_DB_USER" -p"$AVIAN_DB_PASSWORD" \
        --single-transaction --routines --triggers "$AVIAN_DB_NAME" > "$work/database.sql" \
        || { $live && send "save-on"; rm -rf "$work"; fail "Database dump failed; nothing was written."; }

    say "Archiving the world and plugin data…"
    # Extra worlds and the server's player lists, whichever exist.
    local extras=() f
    for f in run/world_* run/ops.json run/whitelist.json run/banned-players.json run/banned-ips.json; do
        [[ -e "$f" ]] && extras+=("$f")
    done
    # Jars come back from downloadPlugins, libs/ from the plugins themselves, logs are not state.
    # tar exits 1 when a file changed while being read. That archive is torn, so it is discarded
    # and retried rather than kept — a quietly corrupt backup is worse than none.
    local attempt
    for attempt in 1 2 3; do
        if tar -czf "$archive" \
            --exclude='*.jar' --exclude='run/plugins/*/libs' --exclude='run/plugins/*/logs' \
            --exclude='run/plugins/spark' --exclude='run/plugins/bStats' --exclude='session.lock' \
            -C . run/world run/plugins \
            "${extras[@]}" \
            -C "$work" database.sql; then
            break
        fi
        rm -f "$archive"
        (( attempt == 3 )) && { $live && send "save-on"; rm -rf "$work"; fail "Archiving failed 3 times (files kept changing); no backup taken."; }
        say "A file changed while archiving; waiting and retrying (attempt $((attempt + 1)) of 3)…"
        sleep 5
        world_quiet || true
    done

    $live && send "save-on"
    rm -rf "$work"
    ok "Backup written: $archive ($(du -h "$archive" | cut -f1))"
    echo "  Not included on purpose: .env (secrets — copy it separately and securely)."
}

# Replaces the database with a dump. It is emptied first: a dump only drops and recreates its own
# tables, so a table added after the backup would survive while the migration history rolls back,
# and the plugin would then refuse to start (a migration re-creating it fails; seen 2026-09-29).
load_database() {
    local mariadb=(docker exec -i avian-mariadb mariadb -u"$AVIAN_DB_USER" -p"$AVIAN_DB_PASSWORD")
    "${mariadb[@]}" -e "DROP DATABASE IF EXISTS \`$AVIAN_DB_NAME\`; CREATE DATABASE \`$AVIAN_DB_NAME\`;" \
        && "${mariadb[@]}" "$AVIAN_DB_NAME" < "$1"
}

cmd_restore() {
    local archive="${1:-}"
    [[ -n "$archive" && -f "$archive" ]] || fail "Usage: ./dev restore backups/avian-backup-<date>.tar.gz"
    session_running && fail "Stop the server first: ./dev stop"
    load_env
    db_healthy || { say "Starting the database…"; docker compose up -d --wait >/dev/null || fail "Could not start the database."; }

    echo "${RED}This REPLACES the current world, plugin data and database with the backup.${RESET}"
    if [[ "${2:-}" != "--yes" ]]; then
        read -r -p "Type 'restore' to continue: " answer
        [[ "$answer" == "restore" ]] || fail "Cancelled; nothing changed."
    fi

    local work
    work="$(mktemp -d)"
    tar -xzf "$archive" -C "$work" || { rm -rf "$work"; fail "Could not read $archive"; }
    [[ -f "$work/database.sql" && -d "$work/run/world" ]] || { rm -rf "$work"; fail "That archive is not an Avian backup."; }

    say "Restoring the database…"
    load_database "$work/database.sql" || { rm -rf "$work"; fail "Database restore failed; the world was not touched."; }

    say "Restoring the world and plugin data…"
    mkdir -p run
    rm -rf run/world run/world_*
    cp -a "$work/run/." run/
    rm -rf "$work"
    # The restored database holds the ranks as they were at backup time, which may predate the
    # current ranks.lp. Clear the "already applied" stamp so the next start re-applies them.
    rm -f "$SETUP_STAMP"
    ok "Restored from $archive. Now: ./dev start"
    echo "  Plugin jars are not in the backup; ./dev start downloads the pinned set."
}

# Moves the game into the server container (docs/DEPLOYMENT.md): the same backup file as
# `./dev restore`, loaded into the database and the container's /data volume instead of run/.
# This is the step for switching this machine from ./dev start to the container, or setting up a
# new machine that runs the container.
cmd_restore_container() {
    local archive="${1:-}"
    [[ -n "$archive" && -f "$archive" ]] || fail "Usage: ./dev restore-container backups/avian-backup-<date>.tar.gz"
    archive="$(cd "$(dirname "$archive")" && pwd)/$(basename "$archive")"
    load_env
    local compose=(docker compose --env-file "$ENV_FILE" --profile server)
    [[ -z "$("${compose[@]}" ps -q --status running server 2>/dev/null)" ]] \
        || fail "Stop the server container first: docker compose --profile server stop server"
    db_healthy || { say "Starting the database…"; "${compose[@]}" up -d --wait mariadb >/dev/null || fail "Could not start the database."; }

    echo "${RED}This REPLACES the container's world and plugin data, and database '$AVIAN_DB_NAME', with the backup.${RESET}"
    if [[ "${2:-}" != "--yes" ]]; then
        read -r -p "Type 'restore' to continue: " answer
        [[ "$answer" == "restore" ]] || fail "Cancelled; nothing changed."
    fi

    local work
    work="$(mktemp -d)"
    tar -xzf "$archive" -C "$work" || { rm -rf "$work"; fail "Could not read $archive"; }
    [[ -f "$work/database.sql" && -d "$work/run/world" ]] || { rm -rf "$work"; fail "That archive is not an Avian backup."; }

    say "Restoring the database…"
    load_database "$work/database.sql" || { rm -rf "$work"; fail "Database restore failed; the world was not touched."; }

    say "Restoring the world and plugin data into the container's volume…"
    # Runs in the image as root only to copy and hand the files to the server's own user.
    "${compose[@]}" run --rm --no-deps -T --user root --entrypoint bash -v "$work/run:/restore:ro" server \
        -c 'rm -rf /data/world /data/world_* && cp -a /restore/. /data/ && chown -R avian:avian /data' \
        || { rm -rf "$work"; fail "Copying into the volume failed. The database is already restored; re-run to retry."; }
    rm -rf "$work"
    ok "Restored from $archive into the container. Start it: docker compose --profile server up -d"
    echo "  Ranks come with the database. A fresh world needs the border once: avian-console \"worldborder set $WORLD_BORDER\""
}

cmd_db() {
    load_env
    db_healthy || fail "The database is not running. Start it with: ./dev start"
    docker exec -it avian-mariadb mariadb -u"$AVIAN_DB_USER" -p"$AVIAN_DB_PASSWORD" "$AVIAN_DB_NAME"
}

cmd_test() {
    load_env
    ./gradlew build
}

# CI: fails if any plugin logged an error or failed to enable, or an expected hook is missing.
cmd_check_log() {
    [[ -f "$LOG" ]] || fail "No log to check"
    local problems=0
    if grep -nE 'ERROR\]|Error occurred while enabling|Could not load plugin|Disabling .* \(Is it up to date\?\)' "$LOG"; then
        echo "${RED}✗ Errors in the server log (above)${RESET}"
        problems=1
    fi
    local expect
    for expect in \
        'Enabled [0-9]+ modules' \
        'Registered the claim_boost upgrade with FactionsUUID' \
        'Hooked FactionsUUID' \
        'Faction upgrades on:' \
        "Enabled module 'ftop'" \
        'CommandTimer.*loaded [0-9]+ tasks' \
        'FactionsUUID\] === Done! ===' \
        'Enabling RoseStacker' \
        'ExcellentEnchants\] Loaded [0-9]+ enchantments' \
        'ExcellentEnchants\] Using tooltip handler: packetevents' \
        'Enabling CrazyAuctions' \
        'auraskills-hikari - Start completed' \
        'AuraSkills\] Loaded [0-9]+ skills' \
        'ViaVersion detected server version' \
        'Took .* to boot Floodgate' \
        'Started Geyser on UDP port' \
        '[1-9][0-9]* GUI menus loaded' \
        'Done \('; do
        if grep -qE "$expect" "$LOG"; then
            ok "log has: $expect"
        else
            echo "${RED}✗ log is missing: $expect${RESET}"
            problems=1
        fi
    done
    (( problems == 0 )) || fail "Server log check failed"
    ok "Server log is clean"
}

# --- Kubernetes: this game's part (the cluster, ArgoCD and Sealed Secrets live in the infra repo). ----
# AVIAN_K8S_CONTEXT / AVIAN_K8S_OVERLAY point these at another cluster (production's k3s box).
K8S_CONTEXT="${AVIAN_K8S_CONTEXT:-k3d-avian}"
K8S_OVERLAY="${AVIAN_K8S_OVERLAY:-deploy/kubernetes/overlays/k3d}"
K8S_NS=avian
kc() { kubectl --context "$K8S_CONTEXT" -n "$K8S_NS" "$@"; }

# Reads one value from the overlay's secret.env (git-ignored).
k8s_secret() { grep -E "^$1=" "$ROOT/$K8S_OVERLAY/secret.env" | head -1 | cut -d= -f2-; }

cmd_k8s() {
    command -v kubectl >/dev/null || fail "kubectl is not installed (docs/DEPLOYMENT.md → Kubernetes)."
    local sub="${1:-status}"; shift || true
    case "$sub" in
        up|down|bootstrap|ui)
            fail "The cluster itself (k3d, ArgoCD, Sealed Secrets) is run from the infra repo: ../infra/infra $sub" ;;
        deploy)
            if [[ "$K8S_CONTEXT" == k3d-* ]]; then
                cmd_image
                say "Importing the image into k3d…"
                k3d image import avian-factions:dev -c "${K8S_CONTEXT#k3d-}" >/dev/null || fail "Image import failed."
            fi
            kubectl --context "$K8S_CONTEXT" -n argocd get application avian >/dev/null 2>&1 \
                || fail "ArgoCD isn't managing $K8S_CONTEXT yet: ../infra/infra bootstrap"
            # Manifests come from main through ArgoCD; this only asks it to re-read now, not in 3 minutes.
            say "ArgoCD applies the manifests from main; asking it to refresh…"
            kubectl --context "$K8S_CONTEXT" -n argocd annotate application avian argocd.argoproj.io/refresh=hard --overwrite >/dev/null
            # A rebuilt image keeps its tag, so replace the pod to pick it up. (Not rollout restart:
            # its annotation is drift that ArgoCD would undo.)
            kc wait --for=jsonpath='{.status.availableReplicas}'=1 statefulset/avian-factions --timeout=2m >/dev/null 2>&1 || true
            kc delete pod avian-factions-0 --ignore-not-found >/dev/null
            say "Waiting for the server (the first boot takes a few minutes)…"
            kc rollout status statefulset/avian-factions --timeout=10m || fail "The server did not become ready: ./dev k8s logs"
            ok "Deployed to $K8S_CONTEXT." ;;
        seal)      k8s_seal ;;
        status) kc get pods,svc,pvc ;;
        logs)   kc logs -f avian-factions-0 ;;
        cmd)    [[ $# -gt 0 ]] || fail "Usage: ./dev k8s cmd \"<console command>\""
                kc exec avian-factions-0 -- avian-console "$*" ;;
        restore) k8s_restore "$@" ;;
        *) fail "Usage: ./dev k8s seal|deploy|status|logs|cmd <command>|restore <backup> [--yes] (the cluster: ../infra/infra)" ;;
    esac
}

# Where each cluster's Sealed Secrets key is kept: outside git, so a recreated cluster can decrypt the
# SealedSecrets already committed (the infra repo's ./infra bootstrap restores it).
K8S_KEYS="${AVIAN_K8S_KEYS:-$HOME/.config/avian/sealed-secrets}"

# Encrypts the overlay's secret.env (git-ignored) into a SealedSecret that only this cluster can open,
# writes it to the overlay as sealed-secret.yaml for committing, and backs up the cluster's key.
k8s_seal() {
    command -v kubeseal >/dev/null || fail "kubeseal is not installed (docs/DEPLOYMENT.md → Kubernetes)."
    local env="$ROOT/$K8S_OVERLAY/secret.env" out="$ROOT/$K8S_OVERLAY/sealed-secret.yaml" kust="$ROOT/$K8S_OVERLAY/kustomization.yaml"
    [[ -f "$env" ]] || fail "Create $K8S_OVERLAY/secret.env first (copy secret.env.example)."
    kubectl --context "$K8S_CONTEXT" -n kube-system rollout status deployment/sealed-secrets-controller --timeout=3m >/dev/null \
        || fail "Sealed Secrets isn't running in $K8S_CONTEXT yet (../infra/infra bootstrap installs it)."
    kubectl --context "$K8S_CONTEXT" -n "$K8S_NS" create secret generic avian-db --from-env-file="$env" --dry-run=client -o yaml \
        | kubeseal --context "$K8S_CONTEXT" --controller-namespace kube-system --format yaml > "$out" \
        || fail "Sealing failed."
    grep -q "sealed-secret.yaml" "$kust" || sed -i 's|^  - \.\./\.\./base$|  - ../../base\n  - sealed-secret.yaml   # the avian-db Secret, encrypted for this cluster (./dev k8s seal)|' "$kust"
    mkdir -p "$K8S_KEYS" && chmod 700 "$K8S_KEYS"
    # Without the server-set fields (uid, resourceVersion…), so bootstrap can create it in a new cluster.
    kubectl --context "$K8S_CONTEXT" -n kube-system get secret -l sealedsecrets.bitnami.com/sealed-secrets-key -o yaml \
        | grep -vE '^ +(uid|resourceVersion|creationTimestamp): ' > "$K8S_KEYS/$K8S_CONTEXT.yaml" \
        && chmod 600 "$K8S_KEYS/$K8S_CONTEXT.yaml"
    ok "Sealed into $K8S_OVERLAY/sealed-secret.yaml. Commit it; ArgoCD applies it from main."
    echo "  The cluster's key is backed up to $K8S_KEYS/$K8S_CONTEXT.yaml (keep it safe, never in git)."
}

# Loads a ./dev backup into the cluster: the database into MariaDB, the world and plugin data into the
# server's volume. The server is scaled to 0 while it runs, and back to 1 after.
k8s_restore() {
    local archive="${1:-}"
    [[ -n "$archive" && -f "$archive" ]] || fail "Usage: ./dev k8s restore backups/avian-backup-<date>.tar.gz [--yes]"
    local root_pw db
    root_pw="$(k8s_secret AVIAN_DB_ROOT_PASSWORD)"; db="$(k8s_secret AVIAN_DB_NAME)"
    [[ -n "$root_pw" && -n "$db" ]] || fail "$K8S_OVERLAY/secret.env needs AVIAN_DB_NAME and AVIAN_DB_ROOT_PASSWORD."
    echo "${RED}This REPLACES the world, plugin data and database '$db' in $K8S_CONTEXT with the backup.${RESET}"
    if [[ "${2:-}" != "--yes" ]]; then
        read -r -p "Type 'restore' to continue: " answer
        [[ "$answer" == "restore" ]] || fail "Cancelled; nothing changed."
    fi
    local work
    work="$(mktemp -d)"
    tar -xzf "$archive" -C "$work" || { rm -rf "$work"; fail "Could not read $archive"; }
    [[ -f "$work/database.sql" && -d "$work/run/world" ]] || { rm -rf "$work"; fail "That archive is not an Avian backup."; }

    say "Stopping the server…"
    kc scale statefulset/avian-factions --replicas=0 >/dev/null
    kc wait --for=delete pod/avian-factions-0 --timeout=5m >/dev/null 2>&1 || true

    say "Restoring the database…"
    kc exec avian-mariadb-0 -- mariadb -uroot -p"$root_pw" -e "DROP DATABASE IF EXISTS \`$db\`; CREATE DATABASE \`$db\`;" \
        || { rm -rf "$work"; fail "Could not reset the database; the server is still scaled to 0."; }
    kc exec -i avian-mariadb-0 -- mariadb -uroot -p"$root_pw" "$db" < "$work/database.sql" \
        || { rm -rf "$work"; fail "Database restore failed; the server is still scaled to 0."; }

    say "Restoring the world and plugin data into the server's volume…"
    local image
    image="$(kc get statefulset avian-factions -o jsonpath='{.spec.template.spec.containers[0].image}')"
    # A short-lived pod that mounts the volume as the server's own user (the namespace allows no root),
    # so everything it copies already belongs to the server.
    kc run avian-restore --image="$image" --restart=Never --overrides='{"spec":{"securityContext":{"runAsUser":1001,
        "runAsGroup":1001,"runAsNonRoot":true,"fsGroup":1001,"seccompProfile":{"type":"RuntimeDefault"}},
        "containers":[{"name":"restore","image":"'"$image"'","command":["sleep","3600"],
        "securityContext":{"allowPrivilegeEscalation":false,"capabilities":{"drop":["ALL"]}},
        "volumeMounts":[{"name":"data","mountPath":"/data"}]}],
        "volumes":[{"name":"data","persistentVolumeClaim":{"claimName":"data-avian-factions-0"}}]}}' >/dev/null \
        || { rm -rf "$work"; fail "Could not start the restore pod."; }
    kc wait --for=condition=Ready pod/avian-restore --timeout=3m >/dev/null || { kc delete pod avian-restore --wait=false >/dev/null; rm -rf "$work"; fail "The restore pod did not start."; }
    if ! { kc exec avian-restore -- sh -c 'rm -rf /data/world /data/world_*' \
            && tar -C "$work/run" -cf - . | kc exec -i avian-restore -- tar -C /data --no-overwrite-dir -m -xf -; }; then
        kc delete pod avian-restore --wait=false >/dev/null; rm -rf "$work"
        fail "Copying into the volume failed; re-run to retry."
    fi
    kc delete pod avian-restore --wait=false >/dev/null
    rm -rf "$work"

    say "Starting the server…"
    kc scale statefulset/avian-factions --replicas=1 >/dev/null
    kc rollout status statefulset/avian-factions --timeout=10m || fail "The server did not become ready: ./dev k8s logs"
    ok "Restored $archive into $K8S_CONTEXT."
}

cmd_help() {
    cat <<EOF
${BOLD}./dev${RESET} — run the Avian Factions dev server. Full guide: docs/DEVELOPING.md

  ${BOLD}setup${RESET}            First time only: create .env, start the database, download plugins
  ${BOLD}start${RESET}            Build the plugin and start the server in the background
  ${BOLD}stop${RESET}             Save and stop the server
  ${BOLD}restart${RESET}          Stop, rebuild, start: what you run after changing code or config
  ${BOLD}console${RESET}          Open the live server console (leave with Ctrl-b then d)
  ${BOLD}cmd${RESET} <command>    Run one console command and show the reply, e.g. ./dev cmd list
  ${BOLD}logs${RESET}             Watch the server log (Ctrl-C to stop watching)
  ${BOLD}status${RESET}           Is the database and server running?
  ${BOLD}ranks${RESET}            Re-apply ranks and the world border (start does this when they changed)
  ${BOLD}pack${RESET}             Rebuild the resource pack (start does this when dev-server/ pack files changed)
  ${BOLD}sync${RESET}             Copy dev-server/ config into run/ now (then reload the plugin, or restart)
  ${BOLD}image${RESET}            Build the server container image (avian-factions:dev); see docs/DEPLOYMENT.md
  ${BOLD}backup${RESET}           Save the world, database and plugin data to backups/ (safe while running)
  ${BOLD}restore${RESET} <file>   Replace world, database and plugin data from a backup (server must be stopped)
  ${BOLD}restore-container${RESET} <file>  Load a backup into the server container instead (docs/DEPLOYMENT.md)
  ${BOLD}db${RESET}               Open a MariaDB shell on the dev database
  ${BOLD}test${RESET}             Run every test and build the jar (what CI runs first)
  ${BOLD}k8s${RESET} <sub>        Kubernetes: seal|deploy|status|logs|cmd|restore (the cluster itself: the infra repo)
EOF
}

case "${1:-help}" in
    setup)     shift; cmd_setup "$@" ;;
    start)     shift; cmd_start "$@" ;;
    stop)      shift; cmd_stop ;;
    restart)   shift; cmd_restart "$@" ;;
    console)   shift; cmd_console ;;
    cmd)       shift; cmd_cmd "$@" ;;
    logs)      shift; cmd_logs ;;
    status)    shift; cmd_status ;;
    ranks)     shift; cmd_setup_world ;;
    pack)      shift; cmd_pack ;;
    sync)      shift; cmd_sync ;;
    image)     shift; cmd_image ;;
    backup)    shift; cmd_backup ;;
    restore)   shift; cmd_restore "$@" ;;
    restore-container) shift; cmd_restore_container "$@" ;;
    db)        shift; cmd_db ;;
    test)      shift; cmd_test ;;
    k8s)       shift; cmd_k8s "$@" ;;
    check-log) shift; cmd_check_log ;;
    help|-h|--help) cmd_help ;;
    *) echo "Unknown command: $1" >&2; cmd_help; exit 1 ;;
esac
