# Copy to .env (git-ignored). Read by `docker compose` and, when exported, by the plugin itself:
# every AVIAN_DB_* variable overrides the matching key in plugins/AvianFactions/core.conf.
AVIAN_DB_HOST=127.0.0.1
AVIAN_DB_PORT=3306
AVIAN_DB_NAME=avian
AVIAN_DB_USER=avian
AVIAN_DB_PASSWORD=avian
AVIAN_DB_ROOT_PASSWORD=root

# --- The server container (docs/DEPLOYMENT.md). Unused by ./dev start. ---
# EULA=true accepts the Minecraft EULA (https://aka.ms/MinecraftEULA) for the container.
EULA=false
AVIAN_MEMORY=8G
AVIAN_GAME_PORT=25565
AVIAN_BEDROCK_PORT=19132

# --- Behind a Velocity proxy (the hub). Leave off until the proxy exists. ---
# AVIAN_VELOCITY=true
# AVIAN_VELOCITY_SECRET=<the proxy's forwarding.secret>
# AVIAN_ONLINE_MODE=false
